[Unit]
Description=Wake-word listener for Claude ("привет, Клод")
After=pipewire.service pipewire-pulse.service graphical-session.target
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/susu/voice/bin/wake_daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
